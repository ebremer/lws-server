# ── Maven build output ───────────────────────────────────────────────
# Everything in this project is generated under target/ by `mvn package`
# (compiled classes, the shaded provider JAR, surefire/failsafe reports).
target/

# Other Maven-generated artifacts
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.flattened-pom.xml

# Maven wrapper (none committed today; ignore the downloaded jar if one is added)
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# ── Java / JVM ───────────────────────────────────────────────────────
*.class
hs_err_pid*
replay_pid*
*.hprof
.claude

